# ---- Required ----

# PostgreSQL connection. On cPanel: create the database and user under
# "PostgreSQL Databases"; names are prefixed with your cPanel username.
DATABASE_URL=postgres://cpaneluser_tbweb:CHANGE_ME@localhost:5432/cpaneluser_techbucket

# Long random string (at least 32 characters) used to sign admin sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public address of the site, no trailing slash. Used for SEO, sitemap and links.
SITE_URL=https://techbucket.com.np

# Where uploaded images and CVs are stored. Use a folder OUTSIDE the app
# folder so redeploying never deletes uploads.
UPLOAD_DIR=/home/cpaneluser/techbucket-uploads

# ---- Optional ----

# Set to "true" for hosted databases that require SSL (Neon, Supabase, etc.).
DATABASE_SSL=false
# Max database connections (keep small on shared hosting).
DATABASE_POOL_MAX=5

# Email alerts for new enquiries and applications (a cPanel mailbox works).
SMTP_HOST=mail.techbucket.com.np
SMTP_PORT=465
SMTP_USER=noreply@techbucket.com.np
SMTP_PASS=
SMTP_FROM="Tech Bucket Website <noreply@techbucket.com.np>"

# Apply database migrations automatically on start (production default: true)
AUTO_MIGRATE=true
